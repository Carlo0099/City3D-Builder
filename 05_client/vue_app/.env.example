# =============================================================================
# 前端客户端环境变量配置模板 (.env.example)
#
# 使用方式：
# 复制此文件为 .env 即可生效；若保持留空，系统将自动采用开源免鉴权源 (ESRI/椭球基准) 正常运行。
# =============================================================================

# Cesium Ion 访问凭证 (可选。留空时使用开源离线模式或标准 WGS84 椭球面)
VITE_CESIUM_ION_TOKEN=

# 国家测绘天地图开发者 Token (可在 https://www.tianditu.gov.cn/ 免费申请个人 Token)
# 留空时系统将自动平滑降级为全球免鉴权 ESRI 高清卫星影像
VITE_TIANDITU_KEY=
