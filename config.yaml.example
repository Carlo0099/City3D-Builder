# =============================================================================
# RebuildBuildings 空间多模态与三维重建管线全局配置模板 (config.yaml.example)
#
# 使用方式：
# 复制本文件为 config.yaml，并根据本地环境按需修改。未配置的项将自动采用智能兜底策略。
# =============================================================================

project:
  name: "三维数字孪生城市建模系统"
  version: "1.0.0"
  crs: "EPSG:4326"

# -----------------------------------------------------------------------------
# 1. 建模软件与运行环境
# -----------------------------------------------------------------------------
environment:
  # Blender 可执行程序绝对路径 (留空时系统将自动在 PATH、系统默认安装目录进行搜寻)
  # Windows 示例: "C:\\Program Files\\Blender Foundation\\Blender 4.2\\blender.exe"
  blender_exe: ""

# -----------------------------------------------------------------------------
# 2. 底图服务插槽 (Basemap Slot)
# -----------------------------------------------------------------------------
basemap:
  # 可选模式:
  #   - 'esri': 全球免费免鉴权高清卫星影像 (开源推荐，开箱即用)
  #   - 'tianditu': 国家测绘天地图 (需填写 tianditu_token)
  #   - 'offline_xyz': 本地离线切片服务
  mode: "esri"

  # 天地图开发者 Token (在 tianditu.gov.cn 免费申请，留空则自动降级为 esri 模式)
  tianditu_token: ""

  # 离线 XYZ 切片模板路径 (仅当 mode 为 offline_xyz 时生效)
  offline_xyz_url: "/data/basemap/{z}/{x}/{y}.png"

# -----------------------------------------------------------------------------
# 3. DEM 地形与高程基准插槽 (DEM Slot)
# -----------------------------------------------------------------------------
elevation:
  # DEM 裸地高程 GeoTIFF 路径 (可填写具体文件，或填写目录自动探测该目录下的 .tif 文件)
  # 留空时自动探测 data/dem/ 目录；若无任何文件则自动平滑降级为 WGS84 椭球基准面
  dem_path: "data/dem"

  # DSM 全表面高程 GeoTIFF 路径 (可填写具体文件，或填写目录自动探测)
  # 留空时自动探测 data/dsm/ 目录；若无任何文件则自动触发形态学或矢量属性退化模式
  dsm_path: "data/dsm"

  # 融合计算策略:
  #   - 'auto': 自动检测可用资产，按最佳路线降级
  #   - 'dem_dsm': 强制执行 nDSM = DSM - DEM 差分计算
  #   - 'dsm_only': 仅 DSM，启用形态学 White Top-Hat 滤波器分离裸地
  #   - 'dem_only': 仅地形贴地吸附与防悬空裙边生成
  #   - 'none': 纯平地基线模式 (Z = 0)
  fusion_mode: "auto"

# -----------------------------------------------------------------------------
# 4. 建筑物二维矢量轮廓插槽 (Vector Slot)
# -----------------------------------------------------------------------------
vector:
  # 输入矢量文件或目录路径 (支持 .geojson / .shp / .dxf)
  # 留空时自动探测 data/vector/ 目录；若无文件则加载内置示范区数据
  input_path: "data/vector"

  # 矢量属性表中的建筑高度字段名 (不区分大小写匹配: height / Height / H 等)
  height_field: "height"

  # 矢量属性表中的建筑层数字段名 (若无高度字段时启用，按 3.3米/层 自动换算)
  floor_field: "Floor"

  # 当完全缺失高度及层数时的兜底建筑默认高度 (单位: 米)
  default_height: 18.0
