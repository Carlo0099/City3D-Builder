# =============================================================================
# City3D-Builder 空间多模态与三维重建管线全局配置模板 (config.yaml.example)
#
# 使用方式：
# 1. 复制本文件为 config.yaml:
#    cp config.yaml.example config.yaml
# 2. 放置对应的数据文件到 data/ 插槽目录即可自动识别；
# 3. 未配置项或缺失的数据将自动采用平滑降级兜底（如默认高度、椭球基准面）。
# =============================================================================

project:
  name: "三维数字孪生城市建模系统"
  version: "1.0.0"
  crs: "EPSG:4326"

# -----------------------------------------------------------------------------
# 1. 建模软件与运行环境
# -----------------------------------------------------------------------------
environment:
  # Blender 可执行程序绝对路径
  # - 留空时系统将自动在环境变量 PATH、系统默认安装目录进行搜寻；
  # - 若未安装 Blender，系统将自动无缝切换为纯 Python 原生极速建模引擎（零依赖）。
  # Windows 示例: "C:\\Program Files\\Blender Foundation\\Blender 4.2\\blender.exe"
  blender_exe: ""

# -----------------------------------------------------------------------------
# 2. 底图服务插槽 (Basemap Slot)
# -----------------------------------------------------------------------------
basemap:
  # 可选模式:
  #   - 'esri': 全球免费免鉴权高清卫星影像 (开源推荐，默认开箱即用)
  #   - 'tianditu': 国家测绘天地图 (需配置 tianditu_token)
  #   - 'offline_xyz': 本地离线切片服务
  mode: "esri"

  # 天地图开发者 Token (在 https://www.tianditu.gov.cn/ 免费申请，留空则自动降级为 esri 模式)
  tianditu_token: ""

  # 离线 XYZ 切片模板路径 (仅当 mode 为 offline_xyz 时生效，切片放置在 data/basemap/ 下)
  offline_xyz_url: "/data/basemap/{z}/{x}/{y}.png"

# -----------------------------------------------------------------------------
# 3. DEM 地形与高程基准插槽 (DEM Slot)
# -----------------------------------------------------------------------------
elevation:
  # DEM 裸地高程 GeoTIFF 路径:
  # - 推荐直接填写目录 "data/dem"，将你的 .tif 放入该目录，系统将自动探测匹配；
  # - 也可以直接指定具体的单文件绝对/相对路径；
  # - 若留空或目录内无任何文件，系统将自动平滑降级为 WGS84 椭球基准面（Z = 0 平地基线）。
  dem_path: "data/dem"

  # DSM 全表面高程 GeoTIFF 路径:
  # - 推荐直接填写目录 "data/dsm"，自动探测；
  # - 若未提供，系统将自动基于 DEM 仅进行地形贴地与防悬空裙边生成。
  dsm_path: "data/dsm"

  # 融合计算策略:
  #   - 'auto': 自动检测可用资产，按最佳路线自适应降级 (推荐)
  #   - 'dem_dsm': 强制执行 nDSM = DSM - DEM 差分计算提取建筑物净高
  #   - 'dem_only': 仅地形贴地吸附与防悬空裙边生成
  #   - 'none': 纯平地基线模式 (Z = 0)
  fusion_mode: "auto"

# -----------------------------------------------------------------------------
# 4. 建筑物二维矢量轮廓插槽 (Vector Slot)
# -----------------------------------------------------------------------------
vector:
  # 输入矢量文件或目录路径:
  # - 推荐直接填写目录 "data/vector"，将建筑物 .shp (连同.dbf/.shx/.prj) 或 .geojson 放入该目录；
  # - 也可以直接指定具体的单文件绝对/相对路径；
  # - 系统将根据用户框选或绘制的 AOI 范围，自动检索并正交化规整落在范围内的建筑物要素。
  input_path: "data/vector"

  # 矢量属性表中的建筑高度字段名 (大小写不敏感，常见字段: height / Height / H / 建筑高度)
  height_field: "height"

  # 矢量属性表中的建筑层数字段名 (若属性缺少高度字段时启用，按 3.3米/层 自动折算)
  floor_field: "Floor"

  # 当完全缺失高度及层数时的兜底建筑默认高度 (单位: 米)
  default_height: 18.0
