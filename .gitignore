# =============================================================================
# Git 忽略配置规则 (.gitignore)
# 针对开源发布严格限制临时产物、输出结果、大文件与私人凭证
# =============================================================================

# -------------------------------------------------------------
# 1. 各模块运行输出目录 (严格限制任何流水线生成物上传)
# -------------------------------------------------------------
01_ingest/output/*
!01_ingest/output/.gitkeep

02_huntr/output/*
!02_huntr/output/.gitkeep

03_replika/output/*
!03_replika/output/.gitkeep

04_tileset/output/*
!04_tileset/output/.gitkeep

# -------------------------------------------------------------
# 2. 瓦片切片缓存与离线数据
# -------------------------------------------------------------
01_ingest/tiles/*
!01_ingest/tiles/.gitkeep

01_ingest/terrain_tiles/*
!01_ingest/terrain_tiles/.gitkeep

# -------------------------------------------------------------
# 3. 大体积地理空间遥感、高程矩阵与 3D 资产文件
# -------------------------------------------------------------
*.tif
*.tiff
*.tfw
*.npy
*.npz
*.terrain
*.glb
*.gltf
*.b3dm
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.mbtiles

# -------------------------------------------------------------
# 4. 视频录屏、多媒体与测试素材
# -------------------------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv

# -------------------------------------------------------------
# 5. 私人凭证、Token 与本地配置文件 (防止泄漏密钥与私人路径)
# -------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
config.yaml

# 允许保留公开示例模板
!config.yaml.example
!.env.example
!05_client/vue_app/.env.example

# -------------------------------------------------------------
# 6. 数据插槽占位保护 (仅保留说明与占位)
# -------------------------------------------------------------
data/basemap/*
!data/basemap/README.md
!data/basemap/.gitkeep

data/dem/*
!data/dem/README.md
!data/dem/.gitkeep

data/dsm/*
!data/dsm/README.md
!data/dsm/.gitkeep

data/vector/*
!data/vector/README.md
!data/vector/.gitkeep

# -------------------------------------------------------------
# 7. Python 编译产物与虚拟环境
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# -------------------------------------------------------------
# 8. Node.js & 前端客户端构建产物
# -------------------------------------------------------------
node_modules/
05_client/vue_app/node_modules/
05_client/dist/
05_client/vue_app/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# -------------------------------------------------------------
# 9. IDE、操作系统与临时文件
# -------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
